# Core infrastructure. Replace credentials and hostnames for your environment.
PUSHKIN_POSTGRES_DSN=postgres://pushkin:change-me@localhost:5432/pushkin?sslmode=disable
PUSHKIN_MIGRATIONS_TABLE=pushkin_schema_migrations
PUSHKIN_HTTP_ADDRESS=:8080
PUSHKIN_KAFKA_BROKERS=localhost:9092
PUSHKIN_INSTANCE_ID=pushkin-local
PUSHKIN_REDIS_ADDRESS=localhost:6379
PUSHKIN_CASSANDRA_HOSTS=localhost:9042
PUSHKIN_CASSANDRA_KEYSPACE=pushkin_inbox

# Optional metrics-only OpenTelemetry export. Leave the endpoint empty to use
# the no-op provider. docker-compose.telemetry.yml supplies the local value.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pushkin
PUSHKIN_TELEMETRY_METRICS_EXPORT_INTERVAL=10s

# Control-plane authentication. Keep real tenant API keys outside version control.
PUSHKIN_API_KEY_HASH_PEPPER=change-me
PUSHKIN_ADMIN_MASTER_KEY=change-me-too

# AES-256-GCM key for encrypted provider credentials. Supply a distinct random
# 32-byte key in base64 through a secret manager in production.
PUSHKIN_CREDENTIALS_CIPHER_KEY_BASE64=

# Keep false outside local test environments. When true, Pushkin sends to the
# HTTP service at PUSHKIN_TEST_SENDER_URL instead of Firebase.
PUSHKIN_USE_TEST_SENDER=false
PUSHKIN_TEST_SENDER_URL=

# Runtime limits from SPECIFICATION.md.
PUSHKIN_SOURCE_BATCH_MAX_SIZE=5000
PUSHKIN_DELIVERY_PROCESSING_BATCH_SIZE=500
PUSHKIN_DELIVERY_MAX_IN_FLIGHT=1500
PUSHKIN_CAMPAIGN_STARTING_TIMEOUT=1m
PUSHKIN_SCHEDULER_INTERVAL=1s
PUSHKIN_SCHEDULER_BATCH_SIZE=100
PUSHKIN_CAMPAIGN_PROGRESS_BATCH_SIZE=100
PUSHKIN_CAMPAIGN_STATS_BATCH_SIZE=1000
PUSHKIN_INLINE_CAMPAIGN_RUN_BATCH_SIZE=100
PUSHKIN_INLINE_CAMPAIGN_FANOUT_BATCH_SIZE=100
PUSHKIN_NOTIFICATION_PROJECTION_BATCH_SIZE=1000
PUSHKIN_NOTIFICATION_WRITE_MAX_IN_FLIGHT=500
PUSHKIN_CHANNEL_PROVISIONING_INTERVAL=1s
PUSHKIN_TENANT_RATE_PER_MIN=1000000
PUSHKIN_TENANT_RATE_BURST=1000
PUSHKIN_PROVIDER_DEFAULT_RATE_LIMIT_QPS=8000
PUSHKIN_PROVIDER_DEFAULT_RATE_LIMIT_BURST=100

# Retention defaults.
PUSHKIN_KAFKA_WORK_RETENTION=168h
PUSHKIN_KAFKA_PROGRESS_RETENTION=336h
