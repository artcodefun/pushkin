name: pushkin-benchmark-{{ instance_id }}

services:
  pushkin:
    image: {{ pushkin_image }}
    environment:
      PUSHKIN_POSTGRES_DSN: postgres://pushkin:pushkin@{{ postgres_private_ip }}:5432/pushkin?sslmode=disable
      PUSHKIN_MIGRATIONS_TABLE: pushkin_schema_migrations
      PUSHKIN_HTTP_ADDRESS: :8080
      PUSHKIN_KAFKA_BROKERS: {{ kafka_private_ip }}:9092
      PUSHKIN_REDIS_ADDRESS: {{ postgres_private_ip }}:6379
      PUSHKIN_CASSANDRA_HOSTS: {{ cassandra_private_ip }}:9042
      PUSHKIN_CASSANDRA_KEYSPACE: pushkin_inbox
      PUSHKIN_INSTANCE_ID: {{ instance_id }}
      PUSHKIN_API_KEY_HASH_PEPPER: {{ hostvars['localhost'].benchmark_api_key_pepper }}
      PUSHKIN_ADMIN_MASTER_KEY: {{ hostvars['localhost'].benchmark_admin_key }}
      PUSHKIN_CREDENTIALS_CIPHER_KEY_BASE64: {{ hostvars['localhost'].benchmark_cipher_key }}
      PUSHKIN_USE_TEST_SENDER: "true"
      PUSHKIN_TEST_SENDER_URL: http://{{ fake_fcm_private_ip }}:8081
      PUSHKIN_SOURCE_BATCH_MAX_SIZE: "5000"
      PUSHKIN_DELIVERY_PROCESSING_BATCH_SIZE: "1000"
      PUSHKIN_DELIVERY_MAX_IN_FLIGHT: "5000"
      PUSHKIN_CAMPAIGN_PROGRESS_BATCH_SIZE: "2000"
      PUSHKIN_CAMPAIGN_STATS_BATCH_SIZE: "2000"
      PUSHKIN_NOTIFICATION_PROJECTION_BATCH_SIZE: "1000"
      PUSHKIN_NOTIFICATION_WRITE_MAX_IN_FLIGHT: "500"
      PUSHKIN_INLINE_CAMPAIGN_RUN_BATCH_SIZE: "5000"
      PUSHKIN_INLINE_CAMPAIGN_FANOUT_BATCH_SIZE: "2500"
      PUSHKIN_SCHEDULER_BATCH_SIZE: "1000"
      PUSHKIN_PROVIDER_DEFAULT_RATE_LIMIT_QPS: "{{ provider_rate_limit_qps }}"
      PUSHKIN_PROVIDER_DEFAULT_RATE_LIMIT_BURST: "{{ provider_rate_limit_burst }}"
    ports: ["127.0.0.1:8080:8080"]
