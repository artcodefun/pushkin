name: pushkin-benchmark-cassandra

services:
  cassandra:
    image: cassandra:5.0
    environment:
      CASSANDRA_CLUSTER_NAME: pushkin-benchmark
      CASSANDRA_NUM_TOKENS: 1
      MAX_HEAP_SIZE: 2G
      HEAP_NEWSIZE: 512M
    ports: ["{{ private_ip }}:9042:9042"]
    healthcheck:
      test: [CMD-SHELL, "cqlsh -e 'DESCRIBE KEYSPACES' localhost 9042 >/dev/null"]
      interval: 10s
      timeout: 10s
      retries: 30
    volumes: [cassandra_data:/var/lib/cassandra]

  migrate-cassandra:
    image: cassandra:5.0
    command: [bash, /migrations/migrate.sh]
    environment:
      PUSHKIN_CASSANDRA_KEYSPACE: pushkin_inbox
    depends_on:
      cassandra: { condition: service_healthy }
    volumes:
      - {{ benchmark_root }}/source/internal/infrastructure/cassandra/migrations:/migrations:ro

volumes:
  cassandra_data:
