project_id          = "your-google-cloud-project-id"
ssh_public_key_path = "/Users/your-user/.ssh/id_ed25519.pub"
ssh_allowed_cidr    = "203.0.113.10/32"

# One SSH bastion, three additional Pushkin VMs, and four service VMs
# (Kafka, PostgreSQL/Redis, Cassandra, and Fake FCM).
pushkin_instance_count = 4

