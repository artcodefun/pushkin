# Copy to terraform.tfvars and replace with your own values. This file is ignored.
project_id            = "your-google-cloud-project-id"
ssh_public_key_path   = "/Users/you/.ssh/id_ed25519.pub"
operator_allowed_cidr = "203.0.113.10/32"

# Keep these aligned with the GCP benchmark environments unless a deliberate
# regional capacity or data-residency decision requires another location.
region = "europe-west1"
zone   = "europe-west1-b"

# Must be globally unique in Cloud Storage. Terraform refuses to delete either
# bucket while it still contains backups.
postgres_backup_bucket_name  = "pushkin-postgres-backups-example"
cassandra_backup_bucket_name = "pushkin-cassandra-backups-example"

control_plane_count = 3
worker_count        = 2
node_machine_type   = "n2-custom-6-12288"
