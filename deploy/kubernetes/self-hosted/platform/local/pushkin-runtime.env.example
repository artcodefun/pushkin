# Runtime secrets. Do not commit the copied file. The PostgreSQL DSN password
# must match local/postgres-app.env.
PUSHKIN_POSTGRES_DSN=postgres://pushkin:replace-me@pushkin-postgres-rw.pushkin-data.svc:5432/pushkin?sslmode=require
PUSHKIN_API_KEY_HASH_PEPPER=replace-with-a-long-random-secret
PUSHKIN_ADMIN_MASTER_KEY=replace-with-a-long-random-secret
PUSHKIN_CREDENTIALS_CIPHER_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
PUSHKIN_HTTP_ADDRESS=:8080
PUSHKIN_KAFKA_BROKERS=pushkin-kafka-kafka-bootstrap.pushkin-data.svc:9092
PUSHKIN_KAFKA_TOPIC_REPLICATION_FACTOR=3
PUSHKIN_REDIS_ADDRESS=redis-0.redis.pushkin-data.svc:6379
PUSHKIN_CASSANDRA_HOSTS=pushkin-cassandra-dc1-service.k8ssandra-operator.svc:9042
PUSHKIN_CASSANDRA_KEYSPACE=pushkin_inbox
PUSHKIN_CASSANDRA_LOCAL_DATACENTER=dc1
PUSHKIN_CASSANDRA_REPLICATION_FACTOR=3
PUSHKIN_CASSANDRA_CONSISTENCY=LOCAL_QUORUM
