# Terraform state and local input may contain infrastructure identifiers,
# operator IP ranges, and SSH-key locations.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/terraform.tfvars

# Generated by Terraform/Ansible. The kubeconfig contains cluster-admin credentials.
self-hosted/ansible/.generated/

# Production Kubernetes deployment inputs. Examples are committed next to the
# manifests; copied files hold database and Object Storage credentials.
self-hosted/platform/local/*.env
self-hosted/platform/local/medusa-gcp-key.json
self-hosted/platform/local/registry-puller-key.json
